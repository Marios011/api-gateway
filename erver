server:
  port: 9000

spring:
  cloud:
    gateway:
      routes:
        - id: menu-service
          uri: http://localhost:8080
          predicates:
            - Path=/api/products/**
        - id: table-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/tables/**
        - id: order-service
          uri: http://localhost:8083
          predicates:
            - Path=/api/orders/**
